<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.LevelUpController"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">
    <VBox alignment="CENTER" spacing="20">
        <Label text="SUBIU DE NÍVEL!" styleClass="titulo-principal"/>
        <Label fx:id="labelNivel"     styleClass="label-nivel"/>
        <Label text="Distribua seus pontos:" styleClass="label-desc"/>
        <VBox spacing="10" alignment="CENTER">
            <HBox alignment="CENTER" spacing="10">
                <Label text="Força:"             styleClass="label-campo" prefWidth="140"/>
                <Button text="+1" onAction="#onUpForca"        styleClass="btn-up"/>
                <Label fx:id="labelForca"        styleClass="label-atributo"/>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Label text="Poder Paranormal:"  styleClass="label-campo" prefWidth="140"/>
                <Button text="+1" onAction="#onUpPoder"        styleClass="btn-up"/>
                <Label fx:id="labelPoder"        styleClass="label-atributo"/>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Label text="Investigação:"      styleClass="label-campo" prefWidth="140"/>
                <Button text="+1" onAction="#onUpInvestigacao" styleClass="btn-up"/>
                <Label fx:id="labelInvestigacao" styleClass="label-atributo"/>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Label text="Vida:"              styleClass="label-campo" prefWidth="140"/>
                <Button text="+1" onAction="#onUpVida"         styleClass="btn-up"/>
                <Label fx:id="labelVida"         styleClass="label-atributo"/>
            </HBox>
        </VBox>
        <Label fx:id="labelPontosRestantes" styleClass="label-pontos"/>
        <Button text="CONFIRMAR" onAction="#onConfirmar" styleClass="btn-confirmar"/>
    </VBox>
</StackPane>