<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.InventarioController"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">
    <VBox alignment="CENTER" spacing="16" style="-fx-padding: 20;">
        <Label text="INVENTÁRIO" styleClass="titulo-painel"/>
        <ListView fx:id="listaItens" styleClass="lista-itens" prefHeight="320" prefWidth="500"/>
        <Label fx:id="labelDescItem" styleClass="label-desc" wrapText="true"/>
        <HBox alignment="CENTER" spacing="20">
            <Button text="Equipar"    onAction="#onEquipar"    styleClass="btn-acao"/>
            <Button text="Usar Poção" onAction="#onUsarPocao"  styleClass="btn-acao"/>
            <Button text="Voltar"     onAction="#onVoltar"     styleClass="btn-sair"/>
        </HBox>
    </VBox>
</StackPane>