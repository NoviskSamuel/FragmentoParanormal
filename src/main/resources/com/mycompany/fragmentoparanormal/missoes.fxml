<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.MissoesController"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">
    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
        <Label text="SELECIONAR MISSÃO" styleClass="titulo-painel"/>
        <HBox spacing="20" alignment="CENTER">
            <ListView fx:id="listaMissoes" styleClass="lista-missoes" prefWidth="340" prefHeight="320"/>
            <VBox spacing="8" alignment="TOP_LEFT" prefWidth="380">
                <Label fx:id="labelTitulo"    styleClass="label-titulo-missao"/>
                <Label fx:id="labelDescricao" styleClass="label-desc" wrapText="true"/>
                <Label fx:id="labelObjetivo"  styleClass="label-desc"/>
                <Label fx:id="labelNivelMin"  styleClass="label-desc"/>
                <Label fx:id="labelProgresso" styleClass="label-desc"/>
                <Label fx:id="labelErro"      styleClass="label-erro"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER" spacing="30">
            <Button text="CONFIRMAR" onAction="#onConfirmar" styleClass="btn-confirmar"/>
            <Button text="SAIR"      onAction="#onSair"      styleClass="btn-sair"/>
        </HBox>
    </VBox>
</StackPane>