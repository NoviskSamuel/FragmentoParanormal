<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.DescansoController"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">
    <VBox spacing="0" alignment="TOP_CENTER" style="-fx-padding: 0;">
        <HBox styleClass="painel-descanso-header" alignment="CENTER_LEFT" spacing="20"
              style="-fx-padding: 14 24 14 24;">
            <Label text="TURNO DE DESCANSO" styleClass="titulo-descanso"/>
            <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelNomePersonagem" styleClass="label-nome-personagem"/>
            <Label fx:id="labelStaminaAtual"   styleClass="label-stamina"/>
        </HBox>
        <HBox VBox.vgrow="ALWAYS" alignment="CENTER" spacing="60"
              style="-fx-padding: 10 40 10 40;">
            <VBox alignment="CENTER" spacing="12" prefWidth="200">
                <ImageView fx:id="imgPersonagem" fitWidth="150" fitHeight="190"
                           preserveRatio="true"/>
                <Label text="Você precisa\ndescansar..." styleClass="label-desc"
                       style="-fx-text-alignment: CENTER; -fx-font-size: 13px;
                              -fx-text-fill: #884422;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="18" prefWidth="520"
                  styleClass="painel-descanso">

                <Label text="— SEQUÊNCIA DE REFLEXOS —"
                       styleClass="titulo-descanso-sub"/>
                <Label fx:id="labelInstrucao" styleClass="label-descanso-instrucao"
                       wrapText="true" style="-fx-text-alignment: CENTER;
                                              -fx-min-height: 36;"/>
                <HBox alignment="CENTER" spacing="16">
                    <Button fx:id="btnSimbolo0" text="🩸" onAction="#onSimbolo0"
                            styleClass="btn-descanso-simbolo" disable="true"/>
                    <Button fx:id="btnSimbolo1" text="💀" onAction="#onSimbolo1"
                            styleClass="btn-descanso-simbolo" disable="true"/>
                    <Button fx:id="btnSimbolo2" text="⚡" onAction="#onSimbolo2"
                            styleClass="btn-descanso-simbolo" disable="true"/>
                    <Button fx:id="btnSimbolo3" text="👁" onAction="#onSimbolo3"
                            styleClass="btn-descanso-simbolo" disable="true"/>
                </HBox>
                <Label fx:id="labelFeedback" styleClass="label-descanso-feedback"
                       wrapText="true" style="-fx-text-alignment: CENTER;
                                              -fx-min-height: 28;"/>
                <Label fx:id="labelTentativas" styleClass="label-desc"
                       style="-fx-text-fill: #884422; -fx-font-size: 13px;"/>
                <HBox alignment="CENTER" spacing="18"
                      style="-fx-padding: 6 0 0 0;">
                    <Label text="🩸 Sangue"       styleClass="label-descanso-legenda"/>
                    <Label text="💀 Morte"        styleClass="label-descanso-legenda"/>
                    <Label text="⚡ Energia"       styleClass="label-descanso-legenda"/>
                    <Label text="👁 Conhecimento" styleClass="label-descanso-legenda"/>
                </HBox>
                <Button fx:id="btnPular" text="Pular descanso"
                        onAction="#onPular" styleClass="btn-fuga"
                        style="-fx-margin: 10 0 0 0;"/>
                <Label text="✔ Acerto completo: +40 ⚡   ✘ Falha total: +10 ⚡"
                       styleClass="label-desc"
                       style="-fx-text-fill: #664422; -fx-font-size: 12px;"/>
            </VBox>

        </HBox>
    </VBox>
</StackPane>