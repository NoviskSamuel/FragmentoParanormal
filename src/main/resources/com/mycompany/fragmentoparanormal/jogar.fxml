<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.JogarController"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">
    <VBox alignment="CENTER" spacing="30">
        <Label text="FRAGMENTO PARANORMAL" styleClass="titulo-principal"/>
        <HBox alignment="CENTER" spacing="60">
            <Button text="JOGAR COM NOVO JOGADOR"       onAction="#onNovoJogador"       styleClass="btn-grande"/>
            <Button text="JOGAR COM JOGADOR EXISTENTE"  onAction="#onConfirmarExistente" styleClass="btn-grande"/>
        </HBox>
        <ComboBox fx:id="comboPersonagens" styleClass="combo-personagem" prefWidth="300"/>
        <Label    fx:id="labelErro"        styleClass="label-erro"/>
        <Button text="SAIR" onAction="#onSair" styleClass="btn-menu"/>
    </VBox>
</StackPane>