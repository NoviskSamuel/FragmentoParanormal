<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.Confirmacao"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">
    <VBox alignment="CENTER" spacing="24">
        <ImageView fx:id="imgPersonagem" fitWidth="120" fitHeight="160" preserveRatio="true"/>
        <Label fx:id="labelMensagem" styleClass="label-narrativa" wrapText="true" textAlignment="CENTER"/>
        <Label fx:id="labelClasse"   styleClass="label-classe"/>
        <Label fx:id="labelNivel"    styleClass="label-nivel"/>
        <HBox alignment="CENTER" spacing="40">
            <Button text="aceitar" onAction="#onAceitar" styleClass="btn-aceitar"/>
            <Button text="recusar" onAction="#onRecusar" styleClass="btn-recusar"/>
        </HBox>
    </VBox>
</StackPane>