<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.NovoJogador"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">

    <VBox alignment="CENTER" spacing="8">
        <Label text="FRAGMENTO"  styleClass="titulo-principal"/>
        <Label text="PARANORMAL" styleClass="titulo-principal"/>

        <VBox styleClass="painel-formulario" alignment="CENTER" spacing="6">
            <Label text="CRIAR NOVO PERSONAGEM" styleClass="titulo-painel"/>

            <!-- Nome -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitWidth="28" fitHeight="28" opacity="0.7">
                    <image><Image url="@../images/elementos/sangue.png" backgroundLoading="true"/></image>
                </ImageView>
                <Label text="Nome (Nick):" styleClass="label-campo"/>
                <TextField fx:id="campNome" styleClass="campo-texto" prefWidth="320"/>
            </HBox>

            <!-- Classe -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitWidth="28" fitHeight="28" opacity="0.7">
                    <image><Image url="@../images/elementos/morte.png" backgroundLoading="true"/></image>
                </ImageView>
                <Label text="Classe:" styleClass="label-campo"/>
                <VBox spacing="2">
                    <RadioButton fx:id="rbEspecialista" text="Especialista" styleClass="radio-classe">
                        <toggleGroup><ToggleGroup fx:id="grupoClasse"/></toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="rbCombatente" text="Combatente"    toggleGroup="$grupoClasse" styleClass="radio-classe"/>
                    <RadioButton fx:id="rbOcultista"  text="Ocultista" toggleGroup="$grupoClasse" styleClass="radio-classe"/>
                </VBox>
            </HBox>

            <!-- Elemento -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitWidth="28" fitHeight="28" opacity="0.7">
                    <image><Image url="@../images/elementos/energia.webp" backgroundLoading="true"/></image>
                </ImageView>
                <Label text="Elemento:" styleClass="label-campo"/>
                <ComboBox fx:id="comboElemento" styleClass="combo-elemento" prefWidth="200"/>
            </HBox>

            <!-- Gênero -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitWidth="28" fitHeight="28" opacity="0.7">
                    <image><Image url="@../images/elementos/conhecimento.webp" backgroundLoading="true"/></image>
                </ImageView>
                <Label text="Gênero:" styleClass="label-campo"/>
                <VBox spacing="2">
                    <RadioButton fx:id="rbMasculino" text="Masculino" styleClass="radio-classe">
                        <toggleGroup><ToggleGroup fx:id="grupoGenero"/></toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="rbFeminino" text="Feminino" toggleGroup="$grupoGenero" styleClass="radio-classe"/>
                </VBox>
            </HBox>

            <Label    fx:id="labelDescClasse"      styleClass="label-desc"/>
            <Label    fx:id="labelNomePersonagem"  styleClass="label-nome-personagem"/>
            <ImageView fx:id="imgPreview" fitWidth="80" fitHeight="80" preserveRatio="true"/>
            <Label    fx:id="labelErro"            styleClass="label-erro"/>
            <HBox alignment="CENTER" spacing="30">
                <Button text="CONFIRMAR +" onAction="#onConfirmar" styleClass="btn-confirmar"/>
                <Button text="SAIR"        onAction="#onSair"      styleClass="btn-sair"/>
            </HBox>
        </VBox>
    </VBox>

    <Label text="✦" style="-fx-text-fill: #441100; -fx-font-size: 28px;"
           StackPane.alignment="BOTTOM_RIGHT" translateX="-16" translateY="-14"/>
</StackPane>
