<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.LojaController"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">
    <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40;">
        <Label text="LOJA DA ORDEM" styleClass="titulo-painel"/>
        <Label fx:id="labelMoedas" styleClass="label-nivel"/>
        <HBox alignment="CENTER" spacing="20" fx:id="painelItens"/>
        <Label fx:id="labelMensagem" styleClass="label-narrativa"/>
        <Button text="FECHAR" onAction="#onFechar" styleClass="btn-menu"
                style="-fx-min-width: 200px;"/>
    </VBox>
</StackPane>