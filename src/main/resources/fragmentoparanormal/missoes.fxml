<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.MissoesController"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">

    <ImageView fitWidth="100" fitHeight="100" opacity="0.10" mouseTransparent="true"
               StackPane.alignment="TOP_LEFT" translateX="20" translateY="20">
        <image><Image url="@images/elementos/sangue.png" backgroundLoading="true"/></image>
    </ImageView>
    <ImageView fitWidth="100" fitHeight="100" opacity="0.10" mouseTransparent="true"
               StackPane.alignment="BOTTOM_RIGHT" translateX="-20" translateY="-20">
        <image><Image url="@images/elementos/morte.png" backgroundLoading="true"/></image>
    </ImageView>

    <VBox alignment="CENTER" spacing="14" style="-fx-padding: 24;">
        <Label text="SELECIONAR MISSÃO" styleClass="titulo-painel"/>

        <HBox spacing="20" alignment="TOP_CENTER">
            <!-- Lista de missões -->
            <VBox spacing="6">
                <Label text="MISSÕES DISPONÍVEIS"
                       style="-fx-text-fill: #884433; -fx-font-family: 'Georgia', serif;
                              -fx-font-size: 12px; -fx-font-style: italic;"/>
                <ListView fx:id="listaMissoes" styleClass="lista-missoes"
                          prefWidth="320" prefHeight="300"/>
            </VBox>

            <!-- Detalhes da missão -->
            <VBox spacing="10" alignment="TOP_LEFT" prefWidth="400"
                  style="-fx-background-color: linear-gradient(to bottom, #150000, #0d0008);
                         -fx-border-color: #440011; -fx-border-width: 1;
                         -fx-border-radius: 7; -fx-background-radius: 7;
                         -fx-padding: 20 24 20 24;">
                <Label text="DETALHES" style="-fx-text-fill: #663322;
                       -fx-font-family: 'Georgia', serif; -fx-font-size: 12px;
                       -fx-font-style: italic;"/>
                <Label fx:id="labelTitulo"    styleClass="label-titulo-missao"/>
                <Label fx:id="labelDescricao" styleClass="label-desc" wrapText="true"/>
                <Label fx:id="labelObjetivo"  styleClass="label-desc"/>
                <Label fx:id="labelNivelMin"  styleClass="label-desc"/>
                <Label fx:id="labelProgresso" styleClass="label-fragmento"/>
                <Label fx:id="labelErro"      styleClass="label-erro"/>
            </VBox>
        </HBox>

        <HBox alignment="CENTER" spacing="30" style="-fx-padding: 6 0 0 0;">
            <Button text="INICIAR MISSÃO" onAction="#onConfirmar" styleClass="btn-confirmar"/>
            <Button text="SAIR"           onAction="#onSair"      styleClass="btn-sair"/>
        </HBox>
    </VBox>

    <Label text="✦  FRAGMENTO PARANORMAL  ✦"
           style="-fx-text-fill: #330000; -fx-font-size: 11px; -fx-font-family: 'Georgia', serif;"
           StackPane.alignment="BOTTOM_CENTER" translateY="-12"/>
</StackPane>
