<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.NovoJogador"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">

    <ImageView fitWidth="80" fitHeight="80" opacity="0.12" mouseTransparent="true"
               StackPane.alignment="TOP_LEFT" translateX="20" translateY="20">
        <image><Image url="@images/elementos/sangue.png" backgroundLoading="true"/></image>
    </ImageView>
    <ImageView fitWidth="80" fitHeight="80" opacity="0.12" mouseTransparent="true"
               StackPane.alignment="BOTTOM_RIGHT" translateX="-20" translateY="-20">
        <image><Image url="@images/elementos/conhecimento.webp" backgroundLoading="true"/></image>
    </ImageView>

    <VBox alignment="CENTER" spacing="10">
        <Label text="CRIAR NOVO AGENTE" styleClass="titulo-painel"
               style="-fx-font-size: 28px; -fx-padding: 0 0 6 0;"/>

        <HBox alignment="CENTER" spacing="30">
            <!-- Formulário -->
            <VBox styleClass="painel-formulario" spacing="14" alignment="TOP_LEFT"
                  style="-fx-min-width: 420px; -fx-max-width: 440px;">

                <!-- Nome -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="NOME:" styleClass="label-campo"/>
                    <TextField fx:id="campNome" styleClass="campo-texto" prefWidth="240"
                               promptText="nome do agente"/>
                </HBox>

                <!-- Classe -->
                <VBox spacing="6">
                    <Label text="CLASSE:" styleClass="label-campo"/>
                    <HBox spacing="20" style="-fx-padding: 0 0 0 16;">
                        <RadioButton fx:id="rbEspecialista" text="Especialista" styleClass="radio-classe">
                            <toggleGroup><ToggleGroup fx:id="grupoClasse"/></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbCombatente" text="Combatente" toggleGroup="$grupoClasse" styleClass="radio-classe"/>
                        <RadioButton fx:id="rbOcultista"  text="Ocultista"  toggleGroup="$grupoClasse" styleClass="radio-classe"/>
                    </HBox>
                </VBox>

                <!-- Elemento -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="ELEMENTO:" styleClass="label-campo"/>
                    <ComboBox fx:id="comboElemento" styleClass="combo-elemento" prefWidth="200"
                              promptText="— escolha —"/>
                </HBox>

                <!-- Gênero -->
                <VBox spacing="6">
                    <Label text="GÊNERO:" styleClass="label-campo"/>
                    <HBox spacing="30" style="-fx-padding: 0 0 0 16;">
                        <RadioButton fx:id="rbMasculino" text="Masculino" styleClass="radio-classe">
                            <toggleGroup><ToggleGroup fx:id="grupoGenero"/></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbFeminino" text="Feminino" toggleGroup="$grupoGenero" styleClass="radio-classe"/>
                    </HBox>
                </VBox>

                <Label fx:id="labelDescClasse" styleClass="label-desc" wrapText="true"/>
                <Label fx:id="labelErro"       styleClass="label-erro"  wrapText="true"/>

                <HBox alignment="CENTER" spacing="20" style="-fx-padding: 8 0 0 0;">
                    <Button text="CONFIRMAR" onAction="#onConfirmar" styleClass="btn-confirmar"/>
                    <Button text="SAIR"      onAction="#onSair"      styleClass="btn-sair"/>
                </HBox>
            </VBox>

            <!-- Preview do personagem -->
            <VBox alignment="CENTER" spacing="12"
                  style="-fx-min-width: 200px;">
                <ImageView fx:id="imgPreview" fitWidth="160" fitHeight="200" preserveRatio="true"/>
                <Label fx:id="labelNomePersonagem" styleClass="label-nome-personagem" textAlignment="CENTER"/>
                <Label fx:id="labelClassePreview"  styleClass="label-classe"          textAlignment="CENTER"/>
            </VBox>
        </HBox>
    </VBox>

    <Label text="✦  FRAGMENTO PARANORMAL  ✦"
           style="-fx-text-fill: #330000; -fx-font-size: 11px; -fx-font-family: 'Georgia', serif;"
           StackPane.alignment="BOTTOM_CENTER" translateY="-12"/>
</StackPane>
