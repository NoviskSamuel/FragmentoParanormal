<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.Confirmacao"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">

    <ImageView fitWidth="120" fitHeight="120" opacity="0.10" mouseTransparent="true"
               StackPane.alignment="TOP_LEFT" translateX="20" translateY="20">
        <image><Image url="@../images/elementos/morte.png" backgroundLoading="true"/></image>
    </ImageView>
    <ImageView fitWidth="120" fitHeight="120" opacity="0.10" mouseTransparent="true"
               StackPane.alignment="BOTTOM_RIGHT" translateX="-20" translateY="-20">
        <image><Image url="@../images/elementos/sangue.png" backgroundLoading="true"/></image>
    </ImageView>

    <VBox alignment="CENTER" spacing="0">
        <Label text="A ORDEM TE CHAMA" styleClass="titulo-painel"
               style="-fx-font-size: 22px; -fx-padding: 0 0 20 0;"/>

        <HBox alignment="CENTER" spacing="50">
            <!-- Personagem -->
            <VBox alignment="CENTER" spacing="10">
                <ImageView fx:id="imgPersonagem" fitWidth="160" fitHeight="200" preserveRatio="true"/>
                <Label fx:id="labelClasse" styleClass="label-classe"/>
                <Label fx:id="labelNivel"  styleClass="label-nivel"/>
            </VBox>

            <!-- Mensagem -->
            <VBox alignment="CENTER" spacing="20"
                  style="-fx-max-width: 420px; -fx-padding: 24 32 24 32;
                         -fx-background-color: linear-gradient(to bottom, #150000, #0d0008);
                         -fx-border-color: #550011; -fx-border-width: 1;
                         -fx-border-radius: 8; -fx-background-radius: 8;">
                <Label fx:id="labelMensagem" styleClass="label-narrativa"
                       wrapText="true" textAlignment="CENTER"
                       style="-fx-font-size: 16px;"/>

                <Label text="Você aceita esta missão?"
                       style="-fx-text-fill: #aa5533; -fx-font-family: 'Georgia', serif;
                              -fx-font-size: 14px; -fx-font-style: italic;"/>

                <HBox alignment="CENTER" spacing="30" style="-fx-padding: 10 0 0 0;">
                    <Button text="ACEITAR" onAction="#onAceitar" styleClass="btn-aceitar"/>
                    <Button text="RECUSAR" onAction="#onRecusar" styleClass="btn-recusar"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>

    <Label text="✦  FRAGMENTO PARANORMAL  ✦"
           style="-fx-text-fill: #330000; -fx-font-size: 11px; -fx-font-family: 'Georgia', serif;"
           StackPane.alignment="BOTTOM_CENTER" translateY="-12"/>
</StackPane>
