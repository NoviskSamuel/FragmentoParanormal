<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.PrimaryController"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">

    <!-- Imagem de fundo da missão 1 como ambiente -->
    <ImageView fitWidth="960" fitHeight="640" opacity="0.18" mouseTransparent="true" preserveRatio="false">
        <image><Image url="@images/cenarios/Missao1_sala1.jpg" backgroundLoading="true"/></image>
    </ImageView>

    <!-- Gradiente overlay -->
    <Region mouseTransparent="true" prefWidth="960" prefHeight="640"
            style="-fx-background-color: linear-gradient(to bottom, #0a0000ee, #0a0000aa, #0a0000ee);"/>

    <!-- Ícone Morte — canto superior esquerdo -->
    <ImageView fitWidth="80" fitHeight="80" opacity="0.5" mouseTransparent="true"
               StackPane.alignment="TOP_LEFT" translateX="28" translateY="28">
        <image><Image url="@images/elementos/morte.png" backgroundLoading="true"/></image>
    </ImageView>

    <!-- Ícone Energia — canto superior direito -->
    <ImageView fitWidth="72" fitHeight="72" opacity="0.45" mouseTransparent="true"
               StackPane.alignment="TOP_RIGHT" translateX="-28" translateY="28">
        <image><Image url="@images/elementos/energia.webp" backgroundLoading="true"/></image>
    </ImageView>

    <!-- Ícone Conhecimento — canto inferior esquerdo -->
    <ImageView fitWidth="88" fitHeight="88" opacity="0.35" mouseTransparent="true"
               StackPane.alignment="BOTTOM_LEFT" translateX="20" translateY="-20">
        <image><Image url="@images/elementos/conhecimento.webp" backgroundLoading="true"/></image>
    </ImageView>

    <!-- Ícone Sangue — canto inferior direito -->
    <ImageView fitWidth="80" fitHeight="80" opacity="0.4" mouseTransparent="true"
               StackPane.alignment="BOTTOM_RIGHT" translateX="-20" translateY="-20">
        <image><Image url="@images/elementos/sangue.png" backgroundLoading="true"/></image>
    </ImageView>

    <!-- Linha ornamental superior -->
    <Region prefWidth="600" prefHeight="2" mouseTransparent="true"
            StackPane.alignment="TOP_CENTER" translateY="120"
            style="-fx-background-color: linear-gradient(to right, transparent, #660000, #aa2200, #660000, transparent);"/>

    <!-- Linha ornamental inferior -->
    <Region prefWidth="600" prefHeight="2" mouseTransparent="true"
            StackPane.alignment="BOTTOM_CENTER" translateY="-100"
            style="-fx-background-color: linear-gradient(to right, transparent, #440000, #770000, #440000, transparent);"/>

    <!-- Conteúdo central -->
    <VBox alignment="CENTER" spacing="0">

        <!-- Símbolo decorativo topo -->
        <Label text="✦ — ✦" style="-fx-text-fill: #440000; -fx-font-size: 18px; -fx-padding: 0 0 14 0;"/>

        <!-- Título principal -->
        <Label text="FRAGMENTO"  styleClass="titulo-principal"/>
        <Label text="PARANORMAL" styleClass="titulo-principal"/>

        <!-- Subtítulo -->
        <Label text="— Investigação e Sobrevivência —"
               style="-fx-text-fill: #664433; -fx-font-size: 14px;
                      -fx-font-family: Georgia, serif; -fx-font-style: italic;
                      -fx-padding: 6 0 36 0;"/>

        <!-- Botões -->
        <VBox alignment="CENTER" spacing="14">
            <Button text="JOGAR"    onAction="#onJogar"    styleClass="btn-menu"/>
            <Button text="RANKING"  onAction="#onRanking"  styleClass="btn-menu"/>
            <Button text="CRÉDITOS" onAction="#onCreditos" styleClass="btn-menu"/>
            <Button text="ENCERRAR" onAction="#onEncerrar" styleClass="btn-menu"/>
        </VBox>

        <!-- Ornamento inferior -->
        <Label text="✦ — ✦" style="-fx-text-fill: #330000; -fx-font-size: 16px; -fx-padding: 30 0 0 0;"/>
    </VBox>

    <!-- Versão -->
    <Label text="v1.0"
           style="-fx-text-fill: #2a0000; -fx-font-size: 11px; -fx-font-family: Georgia, serif;"
           StackPane.alignment="BOTTOM_LEFT" translateX="14" translateY="-10"/>
</StackPane>