<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<StackPane prefHeight="640" prefWidth="960" styleClass="tela-fundo" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8" fx:controller="Controller.CreditosController">
   <children>
   
       <ImageView fitHeight="90" fitWidth="90" mouseTransparent="true" opacity="0.12" translateX="24" translateY="24" StackPane.alignment="TOP_LEFT">
           <image>
            <Image backgroundLoading="true" url="@../images/elementos/sangue.png" />
         </image>
       </ImageView>
       <ImageView fitHeight="90" fitWidth="90" mouseTransparent="true" opacity="0.12" translateX="-24" translateY="24" StackPane.alignment="TOP_RIGHT">
           <image>
            <Image backgroundLoading="true" url="@../images/elementos/morte.png" />
         </image>
       </ImageView>
       <ImageView fitHeight="90" fitWidth="90" mouseTransparent="true" opacity="0.10" translateX="24" translateY="-24" StackPane.alignment="BOTTOM_LEFT">
           <image>
            <Image backgroundLoading="true" url="@../images/elementos/energia.webp" />
         </image>
       </ImageView>
       <ImageView fitHeight="90" fitWidth="90" mouseTransparent="true" opacity="0.10" translateX="-24" translateY="-24" StackPane.alignment="BOTTOM_RIGHT">
           <image>
            <Image backgroundLoading="true" url="@../images/elementos/conhecimento.webp" />
         </image>
       </ImageView>
   
       <VBox alignment="CENTER" spacing="0">
      <children>
              <Label styleClass="titulo-principal" text="FRAGMENTO" />
              <Label styleClass="titulo-principal" text="PARANORMAL" />
              <Label style="-fx-text-fill: #440000; -fx-font-size: 14px; -fx-padding: 2 0 20 0;" text="─────────────────────────────" />
      
              <VBox alignment="CENTER" spacing="16" style="-fx-max-width: 480px;" styleClass="painel-formulario">
         <children>
                     <Label styleClass="titulo-painel" text="CRÉDITOS" />
         
                     <Label styleClass="label-credito-titulo" text="DESENVOLVIDO POR" />
                     <Label fx:id="labelCriadores" styleClass="label-credito" text="Samuel 'Novisk' Silva" textAlignment="CENTER" wrapText="true" />
         
                     <Label style="-fx-text-fill: #330000; -fx-font-size: 12px;" text="─────────────" />
         
                     <Label styleClass="label-credito-titulo" text="HISTÓRIA E ROTEIRO" />
                     <Label fx:id="labelArtista" styleClass="label-credito" text="Samuel Silva e Samuel Isaque Coinete Gomes" />
         
                     <Label style="-fx-text-fill: #330000; -fx-font-size: 12px;" text="─────────────" />
         
                     <Label style="-fx-text-fill: #664433; -fx-font-family: 'Georgia', serif;                           -fx-font-size: 12px; -fx-font-style: italic;" text="TLP — Técnicas de Linguagem de Programação 2" />
         
                     <Button onAction="#onVoltar" style="-fx-padding: 16 0 0 0; -fx-min-width: 200px;" styleClass="btn-menu" text="VOLTAR" />
         </children>
              </VBox>
      </children>
       </VBox>
   
       <Label style="-fx-text-fill: #330000; -fx-font-size: 11px; -fx-font-family: 'Georgia', serif;" text="✦  FRAGMENTO PARANORMAL  ✦" translateY="-12" StackPane.alignment="BOTTOM_CENTER" />
   </children>
</StackPane>
