CREATE INDEX IF NOT EXISTS idx_personagem_nivel   ON personagem(nivel DESC);
CREATE INDEX IF NOT EXISTS idx_progresso_personagem ON progresso_missao(personagem_id);
CREATE INDEX IF NOT EXISTS idx_historico_personagem ON historico_partida(personagem_id);
CREATE INDEX IF NOT EXISTS idx_upgrade_personagem   ON upgrade(personagem_id);