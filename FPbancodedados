CREATE TABLE IF NOT EXISTS personagem (
    id                 SERIAL PRIMARY KEY,
    nome               VARCHAR(100)  NOT NULL,
    nivel              INTEGER       NOT NULL DEFAULT 1,
    classe             VARCHAR(20)   NOT NULL CHECK (classe IN ('ESPECIALISTA', 'COMBATENTE', 'OCULTISTA')),
    genero             VARCHAR(20)   NOT NULL CHECK (genero IN ('MASCULINO', 'FEMININO')),
    elemento           VARCHAR(20)   NOT NULL CHECK (elemento IN ('SANGUE', 'MORTE', 'CONHECIMENTO', 'ENERGIA')),
    imagem_path        VARCHAR(255),
    xp_atual           INTEGER       NOT NULL DEFAULT 0,
    xp_proximo_nivel   INTEGER       NOT NULL DEFAULT 100,
    forca              INTEGER       NOT NULL DEFAULT 10,
    poder_paranormal   INTEGER       NOT NULL DEFAULT 10,
    investigacao       INTEGER       NOT NULL DEFAULT 10,
    vida_maxima        INTEGER       NOT NULL DEFAULT 100,
    vida_atual         INTEGER       NOT NULL DEFAULT 100,
    moedas             INTEGER       NOT NULL DEFAULT 0,
    stamina_maxima     INTEGER       NOT NULL DEFAULT 100,
    stamina_atual      INTEGER       NOT NULL DEFAULT 100,
    stamina_atualizada_em TIMESTAMP  NOT NULL DEFAULT NOW()
);

ALTER TABLE personagem ADD COLUMN IF NOT EXISTS stamina_maxima INTEGER NOT NULL DEFAULT 100;
ALTER TABLE personagem ADD COLUMN IF NOT EXISTS stamina_atual  INTEGER NOT NULL DEFAULT 100;
ALTER TABLE personagem ADD COLUMN IF NOT EXISTS stamina_atualizada_em TIMESTAMP NOT NULL DEFAULT NOW();


CREATE TABLE IF NOT EXISTS missao (
    id              SERIAL PRIMARY KEY,
    titulo          VARCHAR(150)  NOT NULL,
    descricao       TEXT,
    objetivo        VARCHAR(255),
    total_objetivo  INTEGER       NOT NULL DEFAULT 1,
    nivel_minimo    INTEGER       NOT NULL DEFAULT 1,
    total_salas     INTEGER       NOT NULL DEFAULT 1
);


CREATE TABLE IF NOT EXISTS progresso_missao (
    personagem_id    INTEGER NOT NULL REFERENCES personagem(id) ON DELETE CASCADE,
    missao_id        INTEGER NOT NULL REFERENCES missao(id)     ON DELETE CASCADE,
    progresso_atual  INTEGER NOT NULL DEFAULT 0,
    sala_atual       INTEGER NOT NULL DEFAULT 1,
    concluida        BOOLEAN NOT NULL DEFAULT FALSE,
    vezes_retornou   INTEGER NOT NULL DEFAULT 0,
    fugiu            BOOLEAN NOT NULL DEFAULT FALSE,
    PRIMARY KEY (personagem_id, missao_id)
);

CREATE TABLE IF NOT EXISTS item (
    id           SERIAL PRIMARY KEY,
    nome         VARCHAR(100) NOT NULL,
    tipo         VARCHAR(50)  NOT NULL,   -- ex: ARMA, ARMADURA, CONSUMIVEL, RELÍQUIA
    valor        INTEGER      NOT NULL DEFAULT 0,
    descricao    TEXT,
    imagem_path  VARCHAR(255)
);

CREATE TABLE IF NOT EXISTS inventario (
    personagem_id  INTEGER NOT NULL REFERENCES personagem(id) ON DELETE CASCADE,
    item_id        INTEGER NOT NULL REFERENCES item(id)       ON DELETE CASCADE,
    equipado       BOOLEAN NOT NULL DEFAULT FALSE,
    PRIMARY KEY (personagem_id, item_id)
);

CREATE TABLE IF NOT EXISTS upgrade (
    id             SERIAL PRIMARY KEY,
    personagem_id  INTEGER      NOT NULL REFERENCES personagem(id) ON DELETE CASCADE,
    atributo       VARCHAR(50)  NOT NULL,   -- ex: forca, poder_paranormal, investigacao
    pontos_gastos  INTEGER      NOT NULL DEFAULT 1,
    realizado_em   TIMESTAMP    NOT NULL DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS historico_partida (
    id             SERIAL PRIMARY KEY,
    personagem_id  INTEGER      NOT NULL REFERENCES personagem(id) ON DELETE CASCADE,
    missao_id      INTEGER      NOT NULL REFERENCES missao(id)     ON DELETE CASCADE,
    resultado      VARCHAR(20)  NOT NULL CHECK (resultado IN ('VITORIA', 'DERROTA', 'FUGA')),
    inimigos_mortos INTEGER     NOT NULL DEFAULT 0,
    moedas_ganhas   INTEGER     NOT NULL DEFAULT 0,
    jogado_em       TIMESTAMP   NOT NULL DEFAULT NOW()
);

