<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.PrimaryController"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">
    <VBox alignment="CENTER" spacing="0">
        <Label text="FRAGMENTO" styleClass="titulo-principal"/>
        <Label text="PARANORMAL" styleClass="titulo-principal"/>
        <VBox alignment="CENTER" spacing="18" style="-fx-padding: 40 0 0 0;">
            <Button text="Jogar"    onAction="#onJogar"    styleClass="btn-menu"/>
            <Button text="Ranking"  onAction="#onRanking"  styleClass="btn-menu"/>
            <Button text="Créditos" onAction="#onCreditos" styleClass="btn-menu"/>
            <Button text="Encerrar" onAction="#onEncerrar" styleClass="btn-menu"/>
        </VBox>
    </VBox>
</StackPane>