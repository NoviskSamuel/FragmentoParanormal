<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.PrimaryController"
           styleClass="tela-fundo" prefWidth="960" prefHeight="640">

    <!-- Ícone de Sangue canto superior esquerdo -->
    <ImageView fitWidth="90" fitHeight="90" opacity="0.5" mouseTransparent="true"
               StackPane.alignment="TOP_LEFT" translateX="30" translateY="30">
        <image><Image url="@../images/elementos/morte.png" backgroundLoading="true"/></image>
    </ImageView>

    <!-- Ícone de Energia canto superior direito -->
    <ImageView fitWidth="80" fitHeight="80" opacity="0.5" mouseTransparent="true"
               StackPane.alignment="TOP_RIGHT" translateX="-30" translateY="30">
        <image><Image url="@../images/elementos/energia.webp" backgroundLoading="true"/></image>
    </ImageView>

    <!-- Ícone de Conhecimento canto inferior esquerdo -->
    <ImageView fitWidth="120" fitHeight="120" opacity="0.35" mouseTransparent="true"
               StackPane.alignment="BOTTOM_LEFT" translateX="20" translateY="-20">
        <image><Image url="@../images/elementos/conhecimento.webp" backgroundLoading="true"/></image>
    </ImageView>

    <!-- Ícone de Sangue canto inferior direito -->
    <ImageView fitWidth="90" fitHeight="90" opacity="0.4" mouseTransparent="true"
               StackPane.alignment="BOTTOM_RIGHT" translateX="-20" translateY="-20">
        <image><Image url="@../images/elementos/sangue.png" backgroundLoading="true"/></image>
    </ImageView>

    <VBox alignment="CENTER" spacing="0">
        <Label text="FRAGMENTO"  styleClass="titulo-principal"/>
        <Label text="PARANORMAL" styleClass="titulo-principal"/>
        <VBox alignment="CENTER" spacing="18" style="-fx-padding: 40 0 0 0;">
            <Button text="Jogar"    onAction="#onJogar"    styleClass="btn-menu"/>
            <Button text="Ranking"  onAction="#onRanking"  styleClass="btn-menu"/>
            <Button text="Créditos" onAction="#onCreditos" styleClass="btn-menu"/>
            <Button text="Encerrar" onAction="#onEncerrar" styleClass="btn-menu"/>
        </VBox>
    </VBox>

    <!-- Diamante decorativo canto inferior direito -->
    <Label text="✦" style="-fx-text-fill: #441100; -fx-font-size: 28px;"
           StackPane.alignment="BOTTOM_RIGHT" translateX="-16" translateY="-14"/>
</StackPane>
